#include <iostream>
using namespace std;

int main() {
	ios_base::sync_with_stdio(0);
	cin.tie(0);

	for (int tc = 1; tc <= 10; tc++) {
		int N;
		cin >> N;

		int ans = 1;
		for (int i = 1; i <= N; i++) {
			int a;
			char m;

			cin >> a >> m;

			if (i * 2 < N) {
				int b, c;
				cin >> b >> c;

				// 자식이 2개인데 숫자이면 잘못됨
				if (m >= '0' && m <= '9') ans = 0;
			}
			else if (i * 2 == N) {
				int b;
				cin >> b;

				// 자식이 1개이면 잘못됨
				ans = 0;
			}
			else {
				// 자식이 없는데 연산자이면 잘못됨
				if (m < '0' || m > '9') ans = 0;
			}
		}

		cout << "#" << tc << " " << ans << "\n";
	}

	return 0;
}