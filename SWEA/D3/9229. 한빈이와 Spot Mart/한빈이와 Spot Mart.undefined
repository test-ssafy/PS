#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int n, m;

int main() {
	ios_base::sync_with_stdio(0);
	cin.tie(0);

	int t;
	cin >> t;

	for (int tc = 1; tc <= t; tc++) {
		cin >> n >> m;

		vector<int> v(n);
		for (int i = 0; i < n; i++) cin >> v[i];

		sort(v.begin(), v.end());

		int l = 0, r = n - 1;
		int ans = -1;

		while (l < r) {
			int sum = v[l] + v[r];

			if (sum <= m) {
				ans = max(ans, sum);
				l++;
			}
			else r --;
		}

		cout << "#" << tc << " " << ans << "\n";
	}

	return 0;
}